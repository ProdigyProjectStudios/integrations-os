# Configure these through hosting environment settings for a deployed Site.
# Local development uses an ignored .dev.vars file.
TOKEN_ENCRYPTION_KEY=
# Rotation: write with NEXT, read NEXT or current, rewrap connections, then promote NEXT.
TOKEN_ENCRYPTION_KEY_NEXT=
BACKUP_ENCRYPTION_KEY=
SITE_SERVICE_TOKEN_SHA256=
SITE_OWNER_EMAIL_SHA256=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEBHOOK_SECRET=
WORKER_TOKEN=
MAINTENANCE_STALE_AFTER_MINUTES=75
# Enable only on a portfolio deployment with SITE_OWNER_EMAIL_SHA256 configured.
PUBLIC_PORTFOLIO_ONLY=false
OPENAI_API_KEY=
OPENAI_MODEL=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_AUTHORIZATION=
# Local collector contract tests only. Leave unset in production.
OTEL_ALLOW_LOCAL=
